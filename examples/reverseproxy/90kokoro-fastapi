# render-if: profile kokoro
server {
	listen 80;
	listen 443 ssl;

	ssl_certificate certs/ainode.crt;
	ssl_certificate_key certs/ainode.key;

	server_name kokoro-fastapi kokoro-fastapi.${AINODE_LAN_DOMAIN};

	proxy_buffering off;
	resolver 127.0.0.11 valid=30s;

	# Bare root -> web player
	location = / {
		return 302 /web/;
	}

	# Kokoro TTS (FastAPI)
	location / {
		proxy_bind $server_addr;
		set $ainode_upstream "http://${AINODE_PREFIX}-kokoro-fastapi:8880";
		proxy_pass $ainode_upstream;

		# Add WebSocket support
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;

		# Timeouts for WebSocket connections
		proxy_read_timeout 86400;
	}
}
