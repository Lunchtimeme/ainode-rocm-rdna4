# render-if: profile hindsight
server {
    listen 80;
    listen 443 ssl;

    ssl_certificate certs/ainode.crt;
    ssl_certificate_key certs/ainode.key;

    server_name hindsight hindsight.${AINODE_LAN_DOMAIN};

    client_max_body_size 16M;
    proxy_buffering off;

    # Hindsight (agent memory: retain / recall / reflect, plus its UI on :9999
    # when it is started separately). No bearer header here on purpose: the
    # service ships without authentication, so treat this vhost as LAN-only.
    location / {
        resolver 127.0.0.11 valid=30s;
        proxy_bind $server_addr;
        set $ainode_upstream "http://${AINODE_PREFIX}-hindsight:8888";
        proxy_pass $ainode_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # Extraction on a local 27B takes seconds to minutes; a reflect run can
        # chain several of them.
        proxy_read_timeout 600;
        proxy_send_timeout 600;
    }
}
