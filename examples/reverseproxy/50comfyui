# render-if: profile comfyui
server {
	listen 80;
	listen 443 ssl;

	ssl_certificate certs/ainode.crt;
	ssl_certificate_key certs/ainode.key;

	server_name comfyui comfyui.${AINODE_LAN_DOMAIN};

	client_max_body_size 1G;

	proxy_buffering off;

	auth_basic "ComfyUI";
	auth_basic_user_file /etc/nginx/htpasswd/.htpasswd;

	# ComfyUI
	location / {
		resolver 127.0.0.11 valid=30s;
		proxy_bind $server_addr;
		set $ainode_upstream "http://${AINODE_PREFIX}-comfyui:8188";
		proxy_pass $ainode_upstream;
	}

	# WebSocket support
	location /ws {
		resolver 127.0.0.11 valid=30s;
		set $ainode_upstream "http://${AINODE_PREFIX}-comfyui:8188";
		proxy_pass $ainode_upstream;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_read_timeout 86400;
	}
}
