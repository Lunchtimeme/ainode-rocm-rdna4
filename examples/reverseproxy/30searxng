# render-if: profile searxng
server {
	listen 80;
	listen 443 ssl;

	ssl_certificate certs/ainode.crt;
	ssl_certificate_key certs/ainode.key;

	server_name searxng searxng.${AINODE_LAN_DOMAIN};

	client_max_body_size 16M;
	proxy_buffering off;

	# SearXNG (privacy-respecting metasearch)
	location / {
		resolver 127.0.0.11 valid=30s;
		proxy_bind $server_addr;
		set $ainode_upstream "http://${AINODE_PREFIX}-searxng:8080";
		proxy_pass $ainode_upstream;

		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header Connection "";
		proxy_read_timeout 300;
	}
}
