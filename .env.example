# ==============================================================================
# AINode - user configuration (example)
# ==============================================================================
#   cp .env.example .env && chmod 600 .env
#
# Every value below has a working default in compose.yml (${VAR:-default}), so a
# .env with only COMPOSE_PROFILES set is a valid installation. Uncomment what
# you want to change; never commit .env.
#
# Three different scopes, do not mix them up:
#   .env                read by `docker compose` itself: images, ports, profiles
#   service environment  runtime settings of a container (see compose.yml)
#   build args in .env   take effect only at the NEXT BUILD of that image, so
#                        get the host ids right before the first build
# ==============================================================================

# ------------------------------------------------------------------------------
# Identity
# ------------------------------------------------------------------------------
# Compose project name and the LAN domain suffix used for vhosts and DNS names.
AINODE_PROJECT=ainode
AINODE_LAN_DOMAIN=localdomain
# Container/hostname prefix. Container-to-container addresses are derived from
# it at runtime, but the nginx vhosts are not: re-run scripts/render-config.sh
# (and add the new names to DNS) after changing it.
# AINODE_PREFIX=ainode
# AINODE_NETWORK=ainode-internal

# ------------------------------------------------------------------------------
# What this installation runs (compose profiles)
# ------------------------------------------------------------------------------
# Always on: ollama, openwebui, chroma, reverseproxy
# Optional:  comfyui, kokoro, searxng, crawl4ai, strata, hindsight,
#            hindsight-decider
#
# A service whose profile is not listed is neither built nor started: this is
# what decides "installed" vs "not installed". `docker compose build` only
# builds what the profiles select, so start small and add later.
#
# Rough first-build cost per optional service (image size to build or pull):
#   searxng    0.4 GB   pull
#   crawl4ai   8 GB     pull (pinned upstream digest)
#   comfyui    24 GB    build, ~13 GB of that is download
#   kokoro     7.3 GB   build, ~3 GB of that is download
#   strata     ~3 GB    pull, plus the model on first start
#   hindsight  1.1 GB   pull, 4.1 GB on disk (CPU only, no GPU needed)
#   hindsight-decider  1.7 GB build + 1.5 GiB weights, CPU only
#
# Default: the two lightweight services, so a first install reaches a working
# stack quickly.
COMPOSE_PROFILES=searxng,crawl4ai
# The usual full local stack:
# COMPOSE_PROFILES=searxng,crawl4ai,comfyui,kokoro,hindsight
# Add strata last, after setting STRATA_API_KEY below:
# COMPOSE_PROFILES=searxng,crawl4ai,comfyui,kokoro,hindsight,strata

# ------------------------------------------------------------------------------
# Host ids  -  set these BEFORE the first build
# ------------------------------------------------------------------------------
#   id -u                                -> AINODE_USER_UID
#   getent group render | cut -d: -f3    -> AINODE_RENDER_GID
#   getent group video  | cut -d: -f3    -> AINODE_VIDEO_GID
#
# AINODE_USER_UID is compiled into the images (it is the user the services run
# as), so set it before the first build.
AINODE_USER_UID=1000
# AINODE_USER_GID=100         # container-internal `users` group, leave as is
#
# The two GPU group ids are applied when a container starts (compose
# group_add), so changing them costs a restart, not a rebuild. The fallbacks
# are 28/27 - Gentoo's numbers - and are only harmless while /dev/kfd and
# /dev/dri/renderD* are world-writable, which is common but not guaranteed.
# AINODE_RENDER_GID=987
# AINODE_VIDEO_GID=983

# ------------------------------------------------------------------------------
# GPU
# ------------------------------------------------------------------------------
# rocminfo | awk '/Name:.*gfx/{print $2; exit}'    -> gfx1201 (RX 9070 XT)
# Selects the PyTorch ROCm wheel extra, torch[device-<arch>], at build time.
# gfx1100 = RX 7900 XTX / RDNA3, gfx1201 = RX 9070 XT / RDNA4.
AINODE_GPU_ARCH=gfx1201

# ------------------------------------------------------------------------------
# Published ports
# ------------------------------------------------------------------------------
# AINODE_HTTP_PORT=80
# AINODE_HTTPS_PORT=443
# AINODE_OLLAMA_PORT=11434
# AINODE_SEARXNG_PORT=8080
# AINODE_ALT_PORT=5000
# SearXNG is published on loopback only; the reverse proxy is the LAN entry
# point. Set 0.0.0.0 to expose the port itself to the network.
# AINODE_SEARXNG_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# Service toggles
# ------------------------------------------------------------------------------
# Bonsai 2 server inside ainode-ollama (needs binaries + GGUFs; safe otherwise)
# PRISM_ENABLE=1
# Set false after creating the admin account (restart, not rebuild)
# ENABLE_SIGNUP=true
# DEFAULT_USER_ROLE=admin
# AINODE_CRAWL4AI_MEM_LIMIT=4g
# AINODE_CRAWL4AI_SHM=1g

# ------------------------------------------------------------------------------
# Secrets   (scripts/init-env.sh fills these in for you)
# ------------------------------------------------------------------------------
# RULE: a value containing '$' must be single-quoted, or .env interpolation
# destroys it. Never put an apr1/htpasswd hash in this file - that is what
# data/reverseproxy/htpasswd/.htpasswd is for (scripts/set-comfyui-password.sh
# creates it from a password you type). The generated vhosts are chmod 600
# because they carry the tokens below.
CRAWL4AI_API_TOKEN=
# SearXNG reads SEARXNG_SECRET natively and it overrides settings.yml.
SEARXNG_SECRET=
# Empty: Open WebUI generates and stores its own key. Set it to keep sessions
# across container replacement; changing it logs every session out once.
WEBUI_SECRET_KEY=
# Required before enabling the `strata` profile.
# STRATA_API_KEY=

# ------------------------------------------------------------------------------
# Versions  (build time: changing one rebuilds that image only)
# ------------------------------------------------------------------------------
# How this works: the *tested* revision is the default inside compose.yml and
# the Dockerfiles, so a plain `git pull` + build gives you the combination this
# repository was validated with. These variables are overrides - set one here to
# try a newer release without editing tracked files.
#
# Upstream refs accept a tag or a commit id. The commit defaults are the ones
# this stack was actually built against; a tag is easier to read, a commit is
# exact. Bump them when a new release works on your card, and mention what you
# tested if you open a PR.
#
# AINODE_OWUI_REF=f8ae8a6c328946dc62cd0712961a0632574581bf   # Open WebUI
# AINODE_KOKORO_REF=61797914e5f8da0baf1d0b97d9d0b15c66625615 # Kokoro-FastAPI
# AINODE_COMFYUI_REF=v0.44.0                                 # see docker/comfyui/Dockerfile.update
# AINODE_CHROMADB_VERSION=0.6.3
#
# Image tags (what compose pulls or tags locally):
# AINODE_COMFYUI_TAG=latest
# AINODE_CRAWL4AI_TAG=latest         # upstream digest is pinned in docker/crawl4ai
# AINODE_SEARXNG_TAG=latest

# ------------------------------------------------------------------------------
# Strata  (profile: strata)
# ------------------------------------------------------------------------------
# AINODE_STRATA_TAG=0.2.13-rocm-gfx120x
# STRATA_MODEL=IQ3_XXS
# STRATA_CONTEXT=32k
# STRATA_VISION=off
# Reuse GGUFs you already have (shards directly in data/common/models/strata/)
# to skip the multi-hour first-start download:
# STRATA_MODEL_PATH=/models/strata

# ------------------------------------------------------------------------------
# Hindsight  (profile: hindsight)
# ------------------------------------------------------------------------------
# Agent memory service: retain / recall / reflect over an embedded PostgreSQL.
# CPU only - the embedder (112M) and reranker (114M) are small CPU models, so it
# needs no /dev/kfd and no ROCm image. 1.1 GB to pull, 4.1 GB on disk, ~1.4 GB RAM
# idle (measured).
#
# The LLM is the only model-backed part: it extracts facts on retain and writes
# consolidated observations. The default points at the Bonsai 2 router in this
# stack, which keeps memory text on this machine. Any OpenAI-compatible endpoint
# works; for a hosted one set the base URL, model and key below.
#
# Hermes (on the host) uses mode=local_external against this API. Its client
# settings live in ~/.hermes/hindsight/config.json.
#
# AINODE_HINDSIGHT_TAG=latest
# Loopback bind: the reverse proxy (hindsight.localdomain) is the LAN entry.
# AINODE_HINDSIGHT_BIND=127.0.0.1
# AINODE_HINDSIGHT_PORT=8888
# AINODE_HINDSIGHT_MEM_LIMIT=4g
#
# The LLM. Bonsai 2 at 16k is the default; the 128k alias also works but costs
# ~3.5 GB more VRAM for no benefit (peak consolidation prompt is ~6.5k tokens).
# AINODE_HINDSIGHT_LLM_PROVIDER=openai
# AINODE_HINDSIGHT_LLM_BASE_URL=http://ainode-ollama:8080/v1
# AINODE_HINDSIGHT_LLM_MODEL=bonsai2-27b-16k
# AINODE_HINDSIGHT_LLM_API_KEY=not-needed
#
# Small-model switches; leave them alone unless you know why they are set.
# AINODE_HINDSIGHT_LLM_STRICT_SCHEMA=true
# AINODE_HINDSIGHT_LLM_REASONING_EFFORT=none
# AINODE_HINDSIGHT_LLM_MAX_CONCURRENT=1
# AINODE_HINDSIGHT_LLM_TIMEOUT=1800
# A wall-clock ceiling for a whole reflect call (it chains several LLM calls).
# AINODE_HINDSIGHT_REFLECT_TIMEOUT=1800
# Observations: the consolidated layer that clients recall by default. Leave it
# on, or every recall answers "No relevant memories found".
# AINODE_HINDSIGHT_OBSERVATIONS=true
# AINODE_HINDSIGHT_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Hindsight decider  (profile: hindsight-decider)
# ------------------------------------------------------------------------------
# Optional CPU model that answers typed yes/no, choice and score questions for
# the memory service, replacing a share of its LLM calls. It is not a chat
# model: one forward pass over the request, no generated tokens, a probability
# per option.
#
# Two switches, not one: enable this profile, and point the memory service at it
# with AINODE_HINDSIGHT_DECISION_PROVIDER=hindsight below. Without the second,
# the container runs and is never called.
#
# First start downloads ~1.5 GiB of weights into
# data/decider/hs-decide-1-flash (resumable, and reused by every later
# recreate). Image is about 1.7 GB, mostly the CPU torch wheel. CPU only on
# purpose - see README.
# Loopback only; the memory service reaches the container by name.
# AINODE_DECIDER_BIND=127.0.0.1
# AINODE_DECIDER_PORT=8001
# One CCD of the 9950X3D; spanning both costs more than it buys.
# AINODE_DECIDER_THREADS=8
# AINODE_DECIDER_CPUS=8
# bfloat16 measured ~2x faster than float32 here (6.4 s vs 12.3 s for a 6.5k
# request) and holds 0.6 GB instead of 3.3 GB. Use float32 without fast bf16.
# AINODE_DECIDER_DTYPE=bfloat16
# Ceiling, not a reservation. bf16 peaks ~1.5 GB; float32 needs 3.3 GB, so
# raise this to 4g when AINODE_DECIDER_DTYPE=float32.
# AINODE_DECIDER_MEM=4g
# AINODE_DECIDER_TORCH=2.13.0
# AINODE_DECIDER_TRANSFORMERS=5.23.0
# AINODE_DECIDER_REF=e2c789026dfd1f7608cafb2ef6a9bb31397af802
#
# Memory-service side. `hindsight` means "a server speaking /v1/systemone".
# AINODE_HINDSIGHT_DECISION_PROVIDER=hindsight
# The server accepts any bearer token; this one is only sent, not checked.
# AINODE_HINDSIGHT_DECISION_API_KEY=local
# AINODE_HINDSIGHT_DECISION_BASE_URL=http://ainode-hindsight-decider:8000
# The CPU server answers one request at a time.
# AINODE_HINDSIGHT_DECISION_CONCURRENCY=1
# AINODE_HINDSIGHT_DECISION_TIMEOUT=120
# Must match the decider's --max-request-tokens; longer work is split.
# AINODE_HINDSIGHT_DECISION_MAX_REQUEST_TOKENS=7168
# Fall back to the LLM when the decider is down, instead of failing.
# AINODE_HINDSIGHT_DECISION_FALLBACK=true
# Consolidation only at first. A wrong judgement is silent, so widen these two
# after spot-checking the decisions for a while.
# AINODE_HINDSIGHT_REFLECT_DECIDER=false
# AINODE_HINDSIGHT_MENTAL_DECIDER=false
