# ==============================================================================
# AINode - user configuration (example)
# ==============================================================================
#   cp .env.example .env && chmod 600 .env
#
# Every value below has a working default in compose.yml (${VAR:-default}), so a
# .env with only COMPOSE_PROFILES set is a valid installation. Uncomment what
# you want to change; never commit .env.
#
# Three different scopes, do not mix them up:
#   .env                read by `docker compose` itself: images, ports, profiles
#   service environment  runtime settings of a container (see compose.yml)
#   build args in .env   take effect only at the next build of that image
# ==============================================================================

# ------------------------------------------------------------------------------
# Identity
# ------------------------------------------------------------------------------
# Compose project name and the LAN domain suffix used for vhosts and DNS names.
AINODE_PROJECT=ainode
AINODE_LAN_DOMAIN=localdomain
# Container/hostname prefix. Changing it also requires re-rendering the nginx
# vhosts (scripts/render-config.sh) and updating Open WebUI's Ollama connection.
# AINODE_PREFIX=ainode
# AINODE_NETWORK=ainode-internal

# ------------------------------------------------------------------------------
# What this installation runs (compose profiles)
# ------------------------------------------------------------------------------
# Always on: ollama, openwebui, chroma, reverseproxy
# Optional:  comfyui, kokoro, searxng, crawl4ai, strata
#
# A service whose profile is not listed is neither built nor started: this is
# what decides "installed" vs "not installed". Start with everything except
# strata, then add what you need; `docker compose --profile X build` only ever
# builds what you ask for.
COMPOSE_PROFILES=comfyui,kokoro,searxng,crawl4ai
# Add strata only after setting STRATA_API_KEY below:
# COMPOSE_PROFILES=comfyui,kokoro,searxng,crawl4ai,strata

# ------------------------------------------------------------------------------
# Host ids
# ------------------------------------------------------------------------------
#   id -u                                 -> AINODE_USER_UID
#   getent group render | cut -d: -f3     -> AINODE_RENDER_GID
#   getent group video  | cut -d: -f3     -> AINODE_VIDEO_GID
# The image defaults (28/27) are Gentoo GIDs and are wrong on Arch; they are
# only harmless while /dev/kfd and /dev/dri/renderD* are world-writable.
AINODE_USER_UID=1000
# AINODE_RENDER_GID=987
# AINODE_VIDEO_GID=983
# AINODE_USER_GID=100          # container-internal `users` group, leave as is

# ------------------------------------------------------------------------------
# GPU
# ------------------------------------------------------------------------------
# rocminfo | awk '/Name:.*gfx/{print $2; exit}'    -> gfx1201 (RX 9070 XT)
# Selects the PyTorch ROCm wheel extra: torch[device-${AINODE_GPU_ARCH}]
# AINODE_GPU_ARCH=gfx1201

# ------------------------------------------------------------------------------
# Published ports
# ------------------------------------------------------------------------------
# AINODE_HTTP_PORT=80
# AINODE_HTTPS_PORT=443
# AINODE_OLLAMA_PORT=11434
# AINODE_SEARXNG_PORT=8080
# AINODE_ALT_PORT=5000

# ------------------------------------------------------------------------------
# Service toggles
# ------------------------------------------------------------------------------
# Bonsai 2 server inside ainode-ollama (needs binaries + GGUFs; safe otherwise)
# PRISM_ENABLE=1
# Set false after creating the admin account
# ENABLE_SIGNUP=true
# DEFAULT_USER_ROLE=admin
# AINODE_CRAWL4AI_MEM_LIMIT=4g
# AINODE_CRAWL4AI_SHM=1g

# ------------------------------------------------------------------------------
# Secrets   (generate with: openssl rand -hex 24)
# ------------------------------------------------------------------------------
# RULE: a value containing '$' must be single-quoted, or .env interpolation
# destroys it. Never put an apr1/htpasswd hash in this file - that is what
# data/reverseproxy/htpasswd/.htpasswd is for (scripts/render-config.sh can
# create it from a password you type).
CRAWL4AI_API_TOKEN=
# SearXNG reads SEARXNG_SECRET natively and it overrides settings.yml.
SEARXNG_SECRET=
# Empty: Open WebUI generates and stores its own key. Set it to keep sessions
# across container replacement; changing it logs every session out once.
WEBUI_SECRET_KEY=
# Required before enabling the `strata` profile.
# STRATA_API_KEY=

# ------------------------------------------------------------------------------
# Pinned versions  (build-time: changing one rebuilds that image only)
# ------------------------------------------------------------------------------
# AINODE_COMFYUI_TAG=latest
# AINODE_COMFYUI_REF=v0.44.0         # see docker/comfyui/Dockerfile.update
# AINODE_CHROMADB_VERSION=0.6.3
# AINODE_CRAWL4AI_TAG=latest         # upstream digest is pinned in docker/crawl4ai
# AINODE_SEARXNG_TAG=latest

# ------------------------------------------------------------------------------
# Strata  (profile: strata)
# ------------------------------------------------------------------------------
# AINODE_STRATA_TAG=0.2.13-rocm-gfx120x
# STRATA_MODEL=IQ3_XXS
# STRATA_CONTEXT=32k
# STRATA_VISION=off
# Reuse GGUFs you already have (shards directly in data/common/models/strata/)
# to skip the multi-hour first-start download:
# STRATA_MODEL_PATH=/models/strata
