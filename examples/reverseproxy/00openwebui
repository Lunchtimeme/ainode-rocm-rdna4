# render-if: none
server {
	listen 80;
	listen 443 ssl;

	ssl_certificate certs/ainode.crt;
	ssl_certificate_key certs/ainode.key;

	server_name openwebui openwebui.${AINODE_LAN_DOMAIN};

	client_max_body_size 1G;

	proxy_buffering off;

	# Open WebUI
	location / {
		resolver 127.0.0.11 valid=30s;
		proxy_bind $server_addr;
		# Deferred resolution: if the container is missing the vhost answers 502
		# instead of stopping nginx from spawning any worker at all.
		set $ainode_upstream "http://${AINODE_PREFIX}-openwebui:8080";
		proxy_pass $ainode_upstream;

		# Add WebSocket support
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;

		# Timeouts for WebSocket connections
		proxy_read_timeout 86400;
	}
}
