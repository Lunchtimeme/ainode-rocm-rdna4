# Fixed configuration for scripts/check-compose.sh.
# Deliberately NOT the user's .env: the point is to detect drift in the
# repository's own compose.yml, reproducibly, on any machine.
AINODE_PROJECT=ainode
AINODE_LAN_DOMAIN=localdomain
COMPOSE_PROFILES=comfyui,kokoro,searxng,crawl4ai,strata,hindsight
AINODE_USER_UID=1000
AINODE_RENDER_GID=28
AINODE_VIDEO_GID=27
AINODE_GPU_ARCH=gfx1201
AINODE_COMFYUI_REF=v0.44.0
PRISM_ENABLE=1
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=admin
CRAWL4AI_API_TOKEN=test-token-not-a-secret
SEARXNG_SECRET=test-secret-not-a-secret
STRATA_API_KEY=test-strata-key-not-a-secret
