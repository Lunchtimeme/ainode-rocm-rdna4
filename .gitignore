# Persistent runtime data, models, conversations, and local configuration
/data/

# Local TLS certificates and private keys (entire folder is local-only)
/ssl/**

# Local environment files and secrets (edit manually per README before first build)
/.env
/.env.*

# Local scratch file
/unused commands

# PrismML llama.cpp binaries are not redistributed with this repository.
# Download a build for your platform and extract it into docker/llamacpp/.
# See "Bonsai 2 via PrismML llama-server" in the README.
/docker/llamacpp/*.tar.gz
/docker/llamacpp/llama-prism-*/
