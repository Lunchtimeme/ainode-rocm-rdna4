# render-if: profile strata
server {
    listen 80;
    listen 443 ssl;

    ssl_certificate certs/ainode.crt;
    ssl_certificate_key certs/ainode.key;

    server_name strata strata.${AINODE_LAN_DOMAIN};

    client_max_body_size 16M;
    proxy_buffering off;

    # Strata (OpenAI-compatible /v1, Anthropic-compatible at /)
    location / {
        resolver 127.0.0.11 valid=30s;
        proxy_bind $server_addr;
        set $ainode_upstream "http://${AINODE_PREFIX}-strata:8080";
        proxy_pass $ainode_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Bearer ${STRATA_API_KEY}";
        proxy_set_header Connection "";
        # Cold start loads tens of GB: first token can take minutes.
        proxy_read_timeout 600;
        proxy_send_timeout 600;
    }
}
