# ==============================================================================
# AINode - user configuration (example)
# ==============================================================================
#   cp .env.example .env && chmod 600 .env
#
# Every value below has a working default in compose.yml (${VAR:-default}), so a
# .env with only COMPOSE_PROFILES set is a valid installation. Uncomment what
# you want to change; never commit .env.
#
# Three different scopes, do not mix them up:
#   .env                read by `docker compose` itself: images, ports, profiles
#   service environment  runtime settings of a container (see compose.yml)
#   build args in .env   take effect only at the NEXT BUILD of that image, so
#                        get the host ids right before the first build
# ==============================================================================

# ------------------------------------------------------------------------------
# Identity
# ------------------------------------------------------------------------------
# Compose project name and the LAN domain suffix used for vhosts and DNS names.
AINODE_PROJECT=ainode
AINODE_LAN_DOMAIN=localdomain
# Container/hostname prefix. Container-to-container addresses are derived from
# it at runtime, but the nginx vhosts are not: re-run scripts/render-config.sh
# (and add the new names to DNS) after changing it.
# AINODE_PREFIX=ainode
# AINODE_NETWORK=ainode-internal

# ------------------------------------------------------------------------------
# What this installation runs (compose profiles)
# ------------------------------------------------------------------------------
# Always on: ollama, openwebui, chroma, reverseproxy
# Optional:  comfyui, kokoro, searxng, crawl4ai, strata
#
# A service whose profile is not listed is neither built nor started: this is
# what decides "installed" vs "not installed". `docker compose build` only
# builds what the profiles select, so start small and add later.
#
# Rough first-build cost per optional service (image size to build or pull):
#   searxng    0.4 GB   pull
#   crawl4ai   8 GB     pull (pinned upstream digest)
#   comfyui    24 GB    build, ~13 GB of that is download
#   kokoro     28 GB    build, ~19 GB of that is download
#   strata     ~3 GB    pull, plus the model on first start
#
# Default: the two lightweight services, so a first install reaches a working
# stack quickly.
COMPOSE_PROFILES=searxng,crawl4ai
# The usual full local stack:
# COMPOSE_PROFILES=searxng,crawl4ai,comfyui,kokoro
# Add strata last, after setting STRATA_API_KEY below:
# COMPOSE_PROFILES=searxng,crawl4ai,comfyui,kokoro,strata

# ------------------------------------------------------------------------------
# Host ids  -  set these BEFORE the first build
# ------------------------------------------------------------------------------
# These are compiled into the images (the container user id and the GPU group
# ids are baked in at build time). Getting them wrong after a build means
# rebuilding the affected images, which is the expensive part.
#
#   id -u                                -> AINODE_USER_UID
#   getent group render | cut -d: -f3    -> AINODE_RENDER_GID
#   getent group video  | cut -d: -f3    -> AINODE_VIDEO_GID
#
# The fallbacks in compose.yml are 28/27, which are Gentoo's group numbers. On
# Arch, CachyOS, Ubuntu, Fedora ... they are almost certainly different.
# They are only harmless while /dev/kfd and /dev/dri/renderD* are world-writable.
AINODE_USER_UID=1000
AINODE_RENDER_GID=987
AINODE_VIDEO_GID=983
# AINODE_USER_GID=100         # container-internal `users` group, leave as is

# ------------------------------------------------------------------------------
# GPU
# ------------------------------------------------------------------------------
# rocminfo | awk '/Name:.*gfx/{print $2; exit}'    -> gfx1201 (RX 9070 XT)
# Selects the PyTorch ROCm wheel extra, torch[device-<arch>], at build time.
# gfx1100 = RX 7900 XTX / RDNA3, gfx1201 = RX 9070 XT / RDNA4.
AINODE_GPU_ARCH=gfx1201

# ------------------------------------------------------------------------------
# Published ports
# ------------------------------------------------------------------------------
# AINODE_HTTP_PORT=80
# AINODE_HTTPS_PORT=443
# AINODE_OLLAMA_PORT=11434
# AINODE_SEARXNG_PORT=8080
# AINODE_ALT_PORT=5000
# SearXNG is published on loopback only; the reverse proxy is the LAN entry
# point. Set 0.0.0.0 to expose the port itself to the network.
# AINODE_SEARXNG_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# Service toggles
# ------------------------------------------------------------------------------
# Bonsai 2 server inside ainode-ollama (needs binaries + GGUFs; safe otherwise)
# PRISM_ENABLE=1
# Set false after creating the admin account (restart, not rebuild)
# ENABLE_SIGNUP=true
# DEFAULT_USER_ROLE=admin
# AINODE_CRAWL4AI_MEM_LIMIT=4g
# AINODE_CRAWL4AI_SHM=1g

# ------------------------------------------------------------------------------
# Secrets   (generate with: openssl rand -hex 24)
# ------------------------------------------------------------------------------
# RULE: a value containing '$' must be single-quoted, or .env interpolation
# destroys it. Never put an apr1/htpasswd hash in this file - that is what
# data/reverseproxy/htpasswd/.htpasswd is for (scripts/set-comfyui-password.sh
# creates it from a password you type). The generated vhosts are chmod 600
# because they carry the tokens below.
CRAWL4AI_API_TOKEN=
# SearXNG reads SEARXNG_SECRET natively and it overrides settings.yml.
SEARXNG_SECRET=
# Empty: Open WebUI generates and stores its own key. Set it to keep sessions
# across container replacement; changing it logs every session out once.
WEBUI_SECRET_KEY=
# Required before enabling the `strata` profile.
# STRATA_API_KEY=

# ------------------------------------------------------------------------------
# Pinned versions  (build-time: changing one rebuilds that image only)
# ------------------------------------------------------------------------------
# AINODE_COMFYUI_TAG=latest
# AINODE_COMFYUI_REF=v0.44.0         # passed to the build; see docker/comfyui/Dockerfile.update
# AINODE_CHROMADB_VERSION=0.6.3
# AINODE_CRAWL4AI_TAG=latest         # upstream digest is pinned in docker/crawl4ai
# AINODE_SEARXNG_TAG=latest

# ------------------------------------------------------------------------------
# Strata  (profile: strata)
# ------------------------------------------------------------------------------
# AINODE_STRATA_TAG=0.2.13-rocm-gfx120x
# STRATA_MODEL=IQ3_XXS
# STRATA_CONTEXT=32k
# STRATA_VISION=off
# Reuse GGUFs you already have (shards directly in data/common/models/strata/)
# to skip the multi-hour first-start download:
# STRATA_MODEL_PATH=/models/strata
